# MockMate backend environment. Copy to backend/.env (local) or ~/MockMate/.env on EC2.
# Never commit the real file. Generate secrets with:
#   python -c "import secrets; print(secrets.token_hex(32))"

# ── Required ────────────────────────────────────────────────────────────────
# Gemini: question generation, transcription, vision, scoring (https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=
# JWT signing keys. MUST be set in production; unset falls back to insecure public defaults.
# Uncomment and fill both: an empty value is NOT the same as unset.
# SECRET_KEY=
# REFRESH_SECRET_KEY=
# Shared secret for internal service-to-service calls (evaluation <-> interview <-> question).
# If unset, a random per-process token is generated (fine for the single-process app).
INTERNAL_API_TOKEN=

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# Any host other than "localhost" connects with sslmode=require (Supabase in production).
POSTGRES_USER=mockmate
POSTGRES_PASSWORD=password
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mockmate_db

# ── Video storage ───────────────────────────────────────────────────────────
# Set to store recordings in S3 (credentials come from the EC2 IAM role or the usual AWS env vars).
# Unset = recordings are written to backend/uploads/videos/ (local dev only).
S3_BUCKET_NAME=

# ── Optional ────────────────────────────────────────────────────────────────
# LLM fallback when Gemini fails (text only)
DEEPSEEK_API_KEY=
# web search context for question generation
TAVILY_API_KEY=
# Google sign-in; same value as the frontend's VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_ID=
# raises GitHub API rate limits for profile analysis
GITHUB_TOKEN=
# extra CORS origin (only needed if the frontend is on another origin)
FRONTEND_URL=http://localhost:5173
# "production" marks the refresh cookie Secure (requires HTTPS)
ENVIRONMENT=development
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Per-user limits
# video uploads (each triggers an AI evaluation)
UPLOAD_RATE_LIMIT=3/hour
# interview sessions created per rolling 24h
MAX_INTERVIEWS_PER_DAY=10

# Rubric practice (/rubric): optional separate grader model, OpenAI-compatible
# JUDGE_API_KEY=
# JUDGE_BASE_URL=
# JUDGE_MODEL=
# local speech-to-text, needs requirements-asr.txt
# WHISPER_MODEL=base

# Internal service URLs: leave unset. app_consolidated.py points them at itself.

# ── Support & review emails ─────────────────────────────────────────────────
# Messages are always saved to the "feedback" table; with these set they are also emailed.
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_USER=mockmate.site@gmail.com, SMTP_PASSWORD=<16-char app password>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
FEEDBACK_TO=mockmate.site@gmail.com
